---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';
import { journey } from '../data/journey';
import { certificates, sortedCerts, certThumb, certDate } from '../data/certificates';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find((p) => p.data.featured) ?? projects[0];
const pdfs = await getCollection('library');
const certs = sortedCerts();
const aws = certificates.find((c) => c.id === 'aws-certified-cloud-practitioner')!;
const stack = ['AWS', 'Docker', 'Kubernetes', 'Terraform', 'GitHub Actions', 'Jenkins', 'Prometheus', 'Grafana', 'Linux', 'Bash', 'Nginx', 'PostgreSQL', 'Redis', 'RabbitMQ', 'FastAPI', 'Git'];
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const headline = "Hi, I'm Ammar.".split(' ');
---
<Base>
  <!-- ───── Hero ───── -->
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">{profile.location}</p>
      <h1 class="words">
        {headline.map((w, i) => <><span class="w" style={`--i:${i}`}>{w}</span>{' '}</>)}
        <br />
        <span class="w" style="--i:3">I</span>{' '}
        <span class="w" style="--i:4">work</span>{' '}
        <span class="w" style="--i:5">on</span><br />
        <span class="w rot-wrap" style="--i:6"><span class="grad" id="rot">cloud infrastructure</span><span class="caret"></span></span>
      </h1>
      <p class="lead reveal">{profile.tagline}</p>
      <div class="cta reveal">
        <a class="btn primary" href="/journey">Follow the journey <span class="arrow">→</span></a>
        <a class="btn" href="/certificates">View certificates</a>
      </div>
    </div>

    <div class="term reveal" aria-label="Terminal animation of my booking platform project">
      <div class="term-bar"><i></i><i></i><i></i><span class="mono">~/ticket-booking-platform</span></div>
      <pre class="term-body" id="term"></pre>
    </div>
  </section>

  <!-- ───── Bento ───── -->
  <section class="bento">
    <div class="card tile now reveal">
      <span class="status">{profile.now.label}</span>
      <p class="big">{profile.now.text}</p>
    </div>

    <a class="card tile cert reveal" href="/certificates">
      <div class="cert-img"><img src={certThumb(aws)} alt="AWS Certified Cloud Practitioner certificate" loading="lazy" /></div>
      <div>
        <span class="mono muted">Certified · {certDate(aws)}</span>
        <p class="cert-name">AWS Cloud Practitioner</p>
      </div>
    </a>

    <div class="card tile stats reveal">
      <div><span class="num"><span data-count="3.5" data-decimals="1">0</span><small>yrs</small></span><span class="muted">IT support</span></div>
      <div><span class="num"><span data-count={certificates.length}>0</span></span><span class="muted">certificates</span></div>
      <div><span class="num"><span data-count={projects.length}>0</span></span><span class="muted">projects</span></div>
    </div>

    {featured && (
      <a class="card tile featured reveal" href={`/projects/${featured.id}`}>
        <div class="orbit" aria-hidden="true">
          {['FastAPI', 'Postgres', 'Redis', 'RabbitMQ', 'Docker'].map((s, i) => <span style={`--k:${i}`}>{s}</span>)}
          <b>5 services</b>
        </div>
        <span class="mono muted">Featured project · {featured.data.period}</span>
        <h3>{featured.data.title}</h3>
        <p class="muted">{featured.data.summary}</p>
        <span class="go mono">Read the build log →</span>
      </a>
    )}

    <div class="card tile study reveal">
      <span class="mono muted">Studying</span>
      <p>{profile.studying}</p>
      <div class="bar-anim"><span></span></div>
    </div>

    <a class="card tile lib reveal" href="/library">
      <span class="mono muted">Library</span>
      {pdfs.length > 0
        ? <span class="num"><span data-count={pdfs.length}>0</span><small>{pdfs.length === 1 ? 'PDF' : 'PDFs'}</small></span>
        : <span class="soon">Coming soon</span>}
      <span class="muted">Notes, cheat sheets &amp; papers</span>
    </a>

    <div class="card tile marquee reveal" aria-label="Tech stack">
      <div class="track">{[...stack, ...stack].map((s) => <span class="chip">{s}</span>)}</div>
      <div class="track rev">{[...stack, ...stack].reverse().map((s) => <span class="chip">{s}</span>)}</div>
    </div>
  </section>

  <!-- ───── Certificates strip ───── -->
  <section class="certs-strip">
    <div class="sec-head reveal">
      <div><p class="eyebrow">Proof of learning</p><h2>{certificates.length} certificates and counting</h2></div>
      <a class="btn" href="/certificates">See all <span class="arrow">→</span></a>
    </div>
    <div class="strip reveal">
      <div class="strip-track">
        {[...certs, ...certs].map((c, i) => (
          <a class="strip-item" href="/certificates" aria-hidden={i >= certs.length ? 'true' : undefined} tabindex={i >= certs.length ? -1 : undefined}>
            <img src={certThumb(c)} alt={i < certs.length ? `${c.title} – ${c.issuer}` : ''} loading="lazy" />
            <span class="mono">{c.issuer}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ───── Notes + milestones ───── -->
  <section class="split">
    <div>
      <div class="sec-head"><h2>Latest notes</h2><a class="mono muted" href="/blog">All posts →</a></div>
      <div class="grid">
        {posts.map((p) => (
          <a class="card post reveal" href={`/blog/${p.id}`}>
            <span class="mono muted">{fmt(p.data.date)}</span>
            <h3>{p.data.title}</h3>
            <p class="muted">{p.data.description}</p>
          </a>
        ))}
      </div>
    </div>
    <div>
      <div class="sec-head"><h2>Recent milestones</h2><a class="mono muted" href="/journey">Full timeline →</a></div>
      <ol class="mini-tl">
        {journey.slice(0, 5).map((m) => (
          <li class="reveal">
            <span class="mono muted">{m.date}</span>
            <strong>{m.title}</strong>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Rotating focus areas in the headline
  const words = ['cloud infrastructure', 'containers', 'CI/CD pipelines', 'Kubernetes', 'Terraform on AWS'];
  const rot = document.getElementById('rot')!;
  if (!reduce) {
    let i = 0;
    const type = async () => {
      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
      for (;;) {
        await sleep(2400);
        const cur = words[i];
        for (let n = cur.length; n >= 0; n--) { rot.textContent = cur.slice(0, n) || '​'; await sleep(28); }
        i = (i + 1) % words.length;
        const next = words[i];
        for (let n = 1; n <= next.length; n++) { rot.textContent = next.slice(0, n); await sleep(55); }
      }
    };
    type();
  }

  // Terminal: real steps from the Ticket Booking Platform build
  const lines: [string, string][] = [
    ['cmd', 'whoami'],
    ['out', 'ammar-zeyad · junior devops & cloud engineer'],
    ['cmd', 'docker compose up -d'],
    ['ok',  ' ✔ Container postgres   Healthy'],
    ['ok',  ' ✔ Container redis      Healthy'],
    ['ok',  ' ✔ Container rabbitmq   Healthy'],
    ['ok',  ' ✔ 3 × FastAPI services Started'],
    ['ok',  ' ✔ 2 × Python workers   Started'],
    ['cmd', 'curl -s localhost/bookings/latest | jq .status'],
    ['hl',  '"CONFIRMED"'],
    ['cmd', 'cat ROADMAP'],
    ['out', 'docker ✓ → ci/cd → kubernetes → terraform on aws'],
  ];
  const term = document.getElementById('term')!;
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const render = (upto: number, partial = '') => {
    term.innerHTML = lines.slice(0, upto).map(([k, t]) =>
      k === 'cmd' ? `<span class="p">❯</span> ${esc(t)}` : `<span class="${k}">${esc(t)}</span>`).join('\n')
      + (partial !== null ? `${upto ? '\n' : ''}<span class="p">❯</span> ${esc(partial)}<span class="tcaret"></span>` : '');
  };
  const runTerm = async () => {
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    for (;;) {
      for (let i = 0; i < lines.length; i++) {
        const [k, t] = lines[i];
        if (k === 'cmd') {
          for (let n = 0; n <= t.length; n++) { render(i, t.slice(0, n)); await sleep(38 + Math.random() * 40); }
          await sleep(350);
        } else { await sleep(k === 'ok' ? 180 : 260); }
        render(i + 1, '');
      }
      await sleep(5000);
    }
  };
  if (reduce) render(lines.length, ''); else runTerm();

  // Subtle 3D tilt on the AWS tile
  const tilt = document.querySelector<HTMLElement>('.cert-img');
  if (tilt && !reduce) {
    const card = tilt.closest<HTMLElement>('.card')!;
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
      tilt.style.transform = `perspective(700px) rotateY(${x * 18}deg) rotateX(${-y * 18}deg) translateZ(10px)`;
    });
    card.addEventListener('pointerleave', () => (tilt.style.transform = ''));
  }
</script>

<style>
  /* Hero */
  .hero { display: grid; grid-template-columns: 1.15fr 1fr; gap: 48px; align-items: center; padding: 72px 0 64px; }
  .hero h1 { font-size: clamp(2.5rem, 6.4vw, 4.8rem); }
  .rot-wrap { white-space: nowrap; }
  .caret { display: inline-block; width: 3px; height: .9em; margin-left: 4px; vertical-align: -0.08em; background: var(--accent); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .lead { font-size: 1.15rem; color: var(--muted); max-width: 560px; margin: 0; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }

  .term {
    border-radius: 18px; overflow: hidden; border: 1px solid var(--line-strong);
    background: color-mix(in srgb, #05070b 92%, transparent);
    box-shadow: 0 40px 80px -30px rgba(0,0,0,.7), 0 0 0 1px rgba(255,255,255,.02), 0 0 80px -20px var(--glow);
    transform: perspective(1200px) rotateY(-8deg) rotateX(3deg);
    transition: transform .8s var(--ease);
  }
  .term:hover { transform: none; }
  .term-bar { display: flex; align-items: center; gap: 7px; padding: 12px 16px; border-bottom: 1px solid rgba(255,255,255,.07); color: #7d8597; }
  .term-bar i { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
  .term-bar i:nth-child(2) { background: #febc2e; }
  .term-bar i:nth-child(3) { background: #28c840; }
  .term-bar span { margin-left: 10px; }
  .term-body {
    margin: 0; padding: 18px 20px 22px; min-height: 340px; color: #c9d1e0;
    font-family: var(--mono); font-size: 0.82rem; line-height: 1.75; white-space: pre-wrap;
  }
  .term-body :global(.p) { color: #7cf5c4; }
  .term-body :global(.ok) { color: #7cf5c4; opacity: .85; }
  .term-body :global(.out) { color: #8d95a8; }
  .term-body :global(.hl) { color: #ffd479; font-weight: 500; }
  .term-body :global(.tcaret) { display: inline-block; width: 8px; height: 1.1em; vertical-align: -0.2em; background: #7cf5c4; animation: blink 1s steps(1) infinite; }

  /* Bento */
  .bento {
    display: grid; gap: 16px;
    grid-template-columns: repeat(4, 1fr);
    grid-template-areas:
      'now now cert stats'
      'feat feat cert stats'
      'feat feat study lib'
      'marq marq marq marq';
  }
  .tile { display: flex; flex-direction: column; gap: 10px; }
  .now { grid-area: now; background: linear-gradient(135deg, var(--card), color-mix(in srgb, var(--accent) 9%, var(--card))); }
  .now .big { font-size: 1.22rem; margin: 0; }
  .cert { grid-area: cert; justify-content: space-between; }
  .cert-img { border-radius: 12px; overflow: hidden; border: 1px solid var(--line); transition: transform .3s var(--ease); box-shadow: 0 20px 40px -20px rgba(0,0,0,.6); }
  .cert-name { font-size: 1.3rem; font-weight: 600; margin: 4px 0 0; line-height: 1.2; }
  .stats { grid-area: stats; justify-content: space-between; }
  .stats > div { display: flex; flex-direction: column; }
  .num { font-size: 2.8rem; font-weight: 700; line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .num small { font-size: 1rem; color: var(--muted); margin-left: 4px; font-weight: 500; }
  .featured { grid-area: feat; justify-content: flex-end; min-height: 340px; overflow: hidden;
    background: radial-gradient(500px 300px at 100% 0%, color-mix(in srgb, var(--accent-2) 20%, transparent), transparent 70%), var(--card); }
  .featured h3 { font-size: 2rem; margin: 0; }
  .featured p { margin: 0; max-width: 520px; }
  .go { color: var(--accent); }
  .orbit { position: relative; flex: none; align-self: flex-end; margin: 18px 40px auto 0; width: 180px; height: 180px; border-radius: 50%; border: 1px dashed var(--line-strong); display: grid; place-items: center; }
  .orbit b { font-family: var(--mono); font-size: .75rem; color: var(--muted); font-weight: 500; }
  .orbit span {
    position: absolute; left: 50%; top: 50%; font-family: var(--mono); font-size: .68rem; padding: 3px 9px; border-radius: 999px;
    background: var(--card-solid); border: 1px solid var(--line-strong); color: var(--text); white-space: nowrap;
    --a: calc(var(--k) * 72deg);
    animation: orbit 24s linear infinite;
  }
  @keyframes orbit {
    from { transform: translate(-50%, -50%) rotate(var(--a)) translateX(90px) rotate(calc(-1 * var(--a))); }
    to   { transform: translate(-50%, -50%) rotate(calc(var(--a) + 360deg)) translateX(90px) rotate(calc(-1 * var(--a) - 360deg)); }
  }
  .study { grid-area: study; }
  .study p { margin: 0; font-weight: 500; }
  .bar-anim { margin-top: auto; height: 4px; border-radius: 4px; background: var(--line); overflow: hidden; }
  .bar-anim span { display: block; height: 100%; width: 30%; border-radius: inherit; background: linear-gradient(90deg, var(--accent), var(--accent-2)); animation: load 2.6s var(--ease) infinite; }
  @keyframes load { 0% { transform: translateX(-100%); } 100% { transform: translateX(340%); } }
  .lib { grid-area: lib; }
  .soon { font-size: 1.5rem; font-weight: 600; }
  .marquee { grid-area: marq; overflow: hidden; gap: 10px; padding: 20px 0; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .track { display: flex; gap: 8px; width: max-content; animation: scroll 40s linear infinite; }
  .track.rev { animation-direction: reverse; animation-duration: 46s; }
  @keyframes scroll { to { transform: translateX(-50%); } }

  /* Certificates strip */
  .certs-strip { margin-top: 96px; }
  .sec-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 22px; flex-wrap: wrap; }
  .sec-head h2 { margin: 0; }
  .strip { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); padding: 10px 0 20px; }
  .strip-track { display: flex; gap: 18px; width: max-content; animation: scroll 70s linear infinite; }
  .strip:hover .strip-track { animation-play-state: paused; }
  .strip-item { width: 260px; flex: none; text-decoration: none; display: flex; flex-direction: column; gap: 8px; color: var(--muted); }
  .strip-item img {
    width: 100%; aspect-ratio: 1.38; object-fit: cover; object-position: top; border-radius: 14px;
    border: 1px solid var(--line-strong); background: #fff;
    transition: transform .5s var(--ease), box-shadow .5s;
  }
  .strip-item:hover img { transform: translateY(-6px) rotate(-1.5deg) scale(1.03); box-shadow: 0 24px 50px -20px rgba(0,0,0,.7), 0 0 0 1px var(--accent); }
  .strip-item:hover { color: var(--text); }

  /* Notes + milestones */
  .split { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; margin-top: 96px; }
  .post h3 { font-size: 1.25rem; margin: 6px 0; }
  .post p { margin: 0; }
  .mini-tl { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--line-strong); }
  .mini-tl li { position: relative; padding: 0 0 22px 22px; display: flex; flex-direction: column; }
  .mini-tl li::before {
    content: ''; position: absolute; left: -7px; top: 6px; width: 12px; height: 12px;
    border-radius: 50%; background: var(--bg); border: 2px solid var(--accent); box-shadow: 0 0 12px var(--glow);
  }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; padding-top: 48px; }
    .term { transform: none; }
    .bento { grid-template-columns: 1fr 1fr; grid-template-areas: 'now now' 'cert stats' 'feat feat' 'study lib' 'marq marq'; }
    .split { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .bento { grid-template-columns: 1fr; grid-template-areas: 'now' 'cert' 'stats' 'feat' 'study' 'lib' 'marq'; }
    .stats { flex-direction: row; flex-wrap: wrap; gap: 20px; }
    .orbit { display: none; }
    .hero h1 { font-size: 2.35rem; min-height: 4.1em; }
    .rot-wrap { white-space: normal; }
    .term-body { font-size: 0.72rem; min-height: 300px; }
    .strip-item { width: 200px; }
  }
</style>
