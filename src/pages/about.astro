---
import Base from '../layouts/Base.astro';
import { profile, skills, certifications, experience, education } from '../data/profile';
---
<Base title="About" description={`${profile.name}: ${profile.role}. Skills, experience, education and contact.`}>
  <header class="page-head">
    <p class="eyebrow">About</p>
    <h1>{profile.name}</h1>
    <p>
      Junior DevOps engineer with three and a half years in IT support. AWS Certified Cloud Practitioner with a BSc (Hons) in
      Information Technology from the University of the West of England, Bristol, now studying for an MSc in Computer Science.
    </p>
    <div class="cta">
      <a class="btn primary" href={`mailto:${profile.email}`}>Get in touch</a>
      <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="btn" href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
    </div>
    <p class="mono rtw">✓ {profile.rightToWork}</p>
  </header>

  <section>
    <h2>Skills</h2>
    <div class="grid grid-3">
      {skills.map((s) => (
        <div class="card reveal">
          <p class="eyebrow">{s.group}</p>
          <div class="chips">{s.items.map((i) => <span class="chip">{i}</span>)}</div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Experience</h2>
    <div class="grid">
      {experience.map((e) => (
        <div class="card xp reveal">
          <div class="xp-head">
            <div><h3>{e.role}</h3><span class="muted">{e.org}</span></div>
            <span class="mono muted">{e.period}</span>
          </div>
          <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="two">
    <div>
      <h2>Education</h2>
      <div class="grid">
        {education.map((e) => (
          <div class="card reveal">
            <span class="mono muted">{e.period}</span>
            <h3>{e.degree}</h3>
            <span class="muted">{e.school}</span>
          </div>
        ))}
      </div>
    </div>
    <div>
      <h2>Certifications</h2>
      <div class="grid">
        {certifications.map((c) => (
          <div class="card reveal">
            {c.date && <span class="mono muted">{c.date}</span>}
            <h3>{c.url ? <a href={c.url} target="_blank" rel="noopener">{c.name} ↗</a> : c.name}</h3>
            <span class="muted">{c.issuer}</span>
          </div>
        ))}
      </div>
      <p class="muted langs">Languages: {profile.languages.join(' · ')}</p>
    </div>
  </section>
</Base>

<style>
  section { margin-top: 56px; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
  .rtw { color: var(--accent); margin-top: 16px !important; }
  h3 { font-size: 1.1rem; margin: 4px 0; }
  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  .xp-head { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .xp ul { margin: 12px 0 0; padding-left: 20px; color: var(--muted); }
  .xp li { margin: 4px 0; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .langs { margin-top: 16px; }
  @media (max-width: 800px) { .two { grid-template-columns: 1fr; } }
</style>
